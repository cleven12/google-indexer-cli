# Copy to .env (gitignored) and set your real domain — never commit real values.
#   set -a; source .env; set +a
#   ./run.sh --list-only --limit 20

SITE=https://example.com
SITEMAP=https://example.com/sitemap.xml
SERVICE_ACCOUNT=service_account.json

# Optional overrides
# DAILY_QUOTA=180
# DELAY_SECONDS=0.25
# PROFILE=demo

# MySQL history backend (optional)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=indexer
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=seo_indexer
